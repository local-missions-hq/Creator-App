{
  "name": "@local-missions/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "contracts:check": "tsx scripts/verify-migration-manifest.ts",
    "db:check": "tsx scripts/check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrations:manifest": "tsx scripts/generate-migration-manifest.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "lint": "eslint src scripts drizzle.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/*.integration.test.ts"
  },
  "dependencies": {
    "@local-missions/contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
