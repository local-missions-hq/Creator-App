{
  "name": "@local-missions/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/local-only/main.local.ts",
    "start": "node dist/main.js",
    "build": "node scripts/clean-production-build.mjs && tsc -p tsconfig.build.json && node scripts/check-production-build.mjs",
    "contracts:check": "tsx scripts/check-openapi.ts",
    "lint": "eslint src scripts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/*.integration.test.ts"
  },
  "dependencies": {
    "@local-missions/config": "workspace:*",
    "@local-missions/contracts": "workspace:*",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-fastify": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "fastify": "5.11.3",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.16.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
