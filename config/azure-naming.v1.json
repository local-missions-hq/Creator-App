{
  "schemaVersion": 1,
  "workload": {
    "name": "local-missions",
    "code": "lm",
    "environment": "development",
    "environmentCode": "dev",
    "region": "eastus2",
    "regionCode": "e2"
  },
  "subscriptionPlacement": {
    "mode": "dedicated-local-missions",
    "observedCandidate": "shared-nonproduction-subscription",
    "observedCandidateEligible": false,
    "dedicatedSubscriptionPreferredBeforeStaging": true,
    "exclusiveResourceGroupsRequired": true,
    "exclusiveStateRequired": true,
    "exclusiveIdentitiesRequired": true,
    "exclusiveBudgetRequired": true,
    "localMissionsResourceGroupPrefix": "rg-local-missions-",
    "observedOtherWorkloadResourceGroupPrefix": "rg-pp-",
    "crossWorkloadTargetsAllowed": false,
    "coTenancyApplyApprovalRequired": true
  },
  "deploymentStamp": {
    "format": "<region-code>r<YYMMDD><sequence>",
    "pattern": "^e2r[0-9]{8}$",
    "example": "e2r26083101",
    "minimumLength": 11,
    "maximumLength": 11,
    "reuseAllowed": false,
    "reason": "A unique stamp prevents collisions across same-day ephemeral runs and soft-deleted global resources."
  },
  "retainedNames": {
    "controlResourceGroup": "rg-local-missions-control-eus2-001",
    "stateResourceGroup": "rg-local-missions-state-eus2-001",
    "workloadLandingZoneResourceGroup": "rg-local-missions-dev-eus2-001",
    "stateStorageAccount": "stlmtfse2001",
    "stateContainer": "tfstate",
    "controlStateKey": "local-missions/control-plane.tfstate",
    "workloadStateKey": "local-missions/dev-workload.tfstate"
  },
  "disposableNameTemplates": [
    {
      "id": "storage-account",
      "scope": "global",
      "template": "stlmdev<stamp>",
      "example": "stlmdeve2r26083101",
      "maximumLength": 24,
      "pattern": "^stlmdeve2r[0-9]{8}$"
    },
    {
      "id": "postgresql-server",
      "scope": "global",
      "template": "psql-local-missions-dev-<stamp>",
      "example": "psql-local-missions-dev-e2r26083101",
      "maximumLength": 63,
      "pattern": "^psql-local-missions-dev-e2r[0-9]{8}$"
    },
    {
      "id": "service-bus-namespace",
