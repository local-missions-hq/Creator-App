{
  "name": "local-missions",
  "version": "0.1.0",
  "private": true,
  "description": "Local Missions local creator marketplace",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=11.24.0 <12"
  },
  "scripts": {
    "azure-cost:check": "node scripts/validate-azure-public-cost-review.mjs",
    "azure-naming:check": "node scripts/validate-azure-naming.mjs",
    "azure-provider-scope:check": "node scripts/validate-azure-provider-scope-plan.mjs",
    "azure-plan-readiness:check": "node scripts/validate-azure-plan-readiness.mjs",
    "azure-placement:check": "node scripts/validate-azure-subscription-placement.mjs",
    "azure-oidc:check": "node scripts/validate-azure-oidc-plan-gate.mjs",
    "build": "turbo run build",
    "container:check": "pnpm build && node scripts/validate-container-images.mjs",
    "authorization:check": "node scripts/validate-authorization-matrix.mjs",
    "contracts:check": "turbo run contracts:check",
    "db:check": "pnpm --filter @local-missions/db db:check",
    "db:generate": "pnpm --filter @local-missions/db db:generate",
    "db:migrate": "pnpm --filter @local-missions/db db:migrate",
    "db:seed": "pnpm --filter @local-missions/db db:seed",
    "dev": "turbo run dev --parallel",
    "external-auth:check": "node scripts/validate-external-auth-gate.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "m5:preflight": "node scripts/validate-m5-local-preflight.mjs",
    "run-ledger:check": "node scripts/validate-ephemeral-run-ledger.mjs",
    "lint": "turbo run lint",
    "prerequisites:check": "node scripts/validate-external-prerequisites.mjs",
    "recovery-drill:check": "node scripts/validate-recovery-drill.mjs",
    "saved-plan:check": "node scripts/validate-saved-plan-evidence.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e:api": "turbo run test:e2e:api",
    "test:e2e:web": "turbo run test:e2e:web",
    "test:e2e:mobile": "turbo run test:e2e:mobile",
    "test:gitleaks": "gitleaks dir . --redact --no-banner",
    "test:security": "node scripts/security-check.mjs",
    "terraform:check": "node scripts/validate-terraform-foundation.mjs",
    "verify": "pnpm format:check && pnpm prerequisites:check && pnpm external-auth:check && pnpm authorization:check && pnpm azure-oidc:check && pnpm saved-plan:check && pnpm run-ledger:check && pnpm recovery-drill:check && pnpm azure-naming:check && pnpm azure-provider-scope:check && pnpm azure-placement:check && pnpm azure-plan-readiness:check && pnpm terraform:check && pnpm azure-cost:check && pnpm m5:preflight && pnpm lint && pnpm typecheck && pnpm test && pnpm contracts:check && pnpm container:check",
    "local:up": "docker compose up -d",
    "local:down": "docker compose down",
    "local:destroy": "docker compose down --volumes --remove-orphans",
    "openapi:generate": "pnpm --filter @local-missions/api openapi:generate",
    "prepare": "simple-git-hooks",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "simple-git-hooks": "2.13.1",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,css}": "prettier --write"
  }
}
